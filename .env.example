# Copy this to .env.local for local development. Get the pooled connection string
# from your Neon project and set it as DATABASE_URL in Vercel as well.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
